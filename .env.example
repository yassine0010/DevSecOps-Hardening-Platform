# Example environment variables for local development

# Database (PostgreSQL)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=mindgrid_user
DB_PASSWORD=change-me-postgres-password
DB_NAME=mindgrid

# JWT
JWT_SECRET=your_jwt_secret_here

# Shared static secret used for service-to-service calls
# Services should include this value in the `X-Service-Key` header when making internal requests
SHARED_SERVICE_KEY=replace_with_strong_shared_key

# CORS: comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080

# Puzzle service URL (used by leaderboard-service for enriched endpoint)
PUZZLE_SERVICE_URL=http://localhost:3002

# Service ports (optional override)
PORT=3000
